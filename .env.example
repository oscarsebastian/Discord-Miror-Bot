# Single mirror job. Copy this file to .env and fill in the values.
DISCORD_TOKEN=
SOURCE_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

MIRROR_NAME=default
POLL_INTERVAL_SECONDS=5
INCOGNITO_MODE=false
FETCH_LIMIT=50
HTTP_TIMEOUT_SECONDS=15
STATE_FILE=data/state.json

# For multiple jobs, uncomment this and configure jobs.json (see jobs.example.json).
# MIRROR_JOBS_FILE=jobs.json
